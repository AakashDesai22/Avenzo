# =============================================================================
# AVENZO Monorepo Git Ignore Policy
# =============================================================================

# Operating System
.DS_Store
Thumbs.db
Desktop.ini
*.tmp

# IDE / Editor
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Python / Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Exception: Flutter consumer app source (must not be ignored)
!consumer-app/lib/
!consumer-app/lib/**
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Secrets (CRITICAL)
.env
.env.*
!.env.example

# Database / Storage
*.sqlite
*.sqlite3
*.db
*.log
*.dump

# Alembic
alembic/versions/*.pyc

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.noserc

# Node / Web (business-web)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/

# Flutter / Dart (consumer-app)
.dart_tool/
.fvm/
.pub-cache/
.pub/
consumer-app/build/
consumer-app/.dart_tool/
consumer-app/.flutter-plugins
consumer-app/.flutter-plugins-dependencies
consumer-app/.packages
consumer-app/android/
consumer-app/ios/
consumer-app/pubspec.lock

# Docker / Logs
*.pid
