# =============================================================================
# AVENZO — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file. It is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://avenzo_user:your_password@localhost:5432/avenzo_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=avenzo_db
DATABASE_USER=avenzo_user
DATABASE_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET=your_very_long_random_secret_key_here_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# BACKEND API
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# AI SERVICE
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=your_ai_service_internal_key_here

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM)
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY_ID=your_private_key_id
# FCM_PRIVATE_KEY is a multiline key — store securely, never hardcode
FCM_PRIVATE_KEY=your_private_key_here
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_CLIENT_ID=your_client_id
FCM_SERVER_KEY=your_fcm_server_key_here

# -----------------------------------------------------------------------------
# OBJECT STORAGE (future — e.g., AWS S3 / Cloudflare R2 / MinIO)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=avenzo-media
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT=https://your-storage-endpoint.com
STORAGE_REGION=ap-south-1

# -----------------------------------------------------------------------------
# REDIS (future — for caching / task queues)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
